backend/media/
backend/private_media/
backend/staticfiles/
backend/test_media/
backend/test_private_media/
*.sqlite3
db.sqlite3-journal
local_settings.py

# Celery
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid

# Schema OpenAPI genere localement
schema.yaml

# =============================================================================
