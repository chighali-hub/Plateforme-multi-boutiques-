# =============================================================================
# Bytecode et caches Python
__pycache__/
*.py[cod]
*$py.class

# Environnements virtuels (le projet tourne dans Docker, mais au cas ou)
.venv/
venv/
env/

# Paquets et distributions Python
*.egg-info/
.eggs/
build/
wheels/

# Tests, couverture, outils qualite
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/

