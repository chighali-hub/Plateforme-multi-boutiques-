# Copier ce fichier en .env :  cp .env.example .env
# Ne jamais commiter le fichier .env.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=changer-cette-cle-en-local-et-en-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_DB=plateforme
POSTGRES_USER=plateforme
POSTGRES_PASSWORD=plateforme
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- E-mail (Mailpit en developpement : http://localhost:8025) ---
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=no-reply@plateforme.local

# --- Front React (Vite) ---
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Ports exposes sur la machine hote ---
# PostgreSQL du conteneur accessible sur localhost:5433 (5433 pour eviter un conflit
# avec un PostgreSQL deja installe sur la machine).
POSTGRES_HOST_PORT=5433
