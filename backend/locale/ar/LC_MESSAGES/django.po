#, python-format
msgid ""
"Bonjour, je souhaite recharger le compte de la boutique %(name)s (%(email)s)."
msgstr "مرحبًا، أرغب في تجديد حساب المتجر %(name)s (%(email)s)."

msgid "Saisissez un numéro mauritanien de 8 chiffres commençant par 2, 3 ou 4."
msgstr "أدخل رقمًا موريتانيًا من 8 أرقام يبدأ بـ 2 أو 3 أو 4."

msgid "Saisissez une couleur au format #RRGGBB."
msgstr "أدخل لونًا بصيغة ‎#RRGGBB."

msgid "Le fichier doit être une image JPEG, PNG ou WebP valide."
msgstr "يجب أن يكون الملف صورة صالحة بصيغة JPEG أو PNG أو WebP."

msgid "L'image dépasse les dimensions autorisées."
msgstr "أبعاد الصورة تتجاوز الحد المسموح به."

msgid "Nouvelle boutique à valider"
msgstr "متجر جديد بانتظار القبول"

msgid "Compte rechargé"
msgstr "تم تجديد الحساب"

msgid "Rappel d'expiration"
msgstr "تذكير بانتهاء الصلاحية"

msgid "Nouvelle commande"
msgstr "طلب جديد"

msgid "Import terminé"
msgstr "اكتمل الاستيراد"

msgid "Import échoué"
msgstr "فشل الاستيراد"

msgid "Produit retiré"
msgstr "تم سحب المنتج"

msgid "notification"
msgstr "إشعار"

msgid "notifications"
msgstr "الإشعارات"

#, python-format
msgid "La boutique %(shop_name)s attend votre validation."
msgstr "المتجر %(shop_name)s بانتظار قبولك."

#, python-format
msgid "La boutique %(shop_name)s a renvoyé sa demande de validation."
msgstr "أعاد المتجر %(shop_name)s إرسال طلب القبول."

#, python-format
msgid "Votre boutique est validée. Elle est active jusqu'au %(expires_at)s."
msgstr "تم قبول متجرك. وهو نشط حتى %(expires_at)s."

msgid "Demande refusée"
msgstr "تم رفض الطلب"

#, python-format
msgid "Votre demande a été refusée : %(reason)s"
msgstr "تم رفض طلبك: %(reason)s"

msgid "Votre boutique a été débloquée."
msgstr "تم رفع الحظر عن متجرك."

#, python-format
msgid "Votre compte est rechargé jusqu'au %(new_expires_at)s."
msgstr "تم تجديد حسابك حتى %(new_expires_at)s."

msgid "Votre compte expire bientôt"
msgstr "تنتهي صلاحية حسابك قريبًا"

#, python-format
msgid "Votre compte expire dans %(days_left)s jour, le %(expires_at)s."
msgid_plural "Votre compte expire dans %(days_left)s jours, le %(expires_at)s."
msgstr[0] "تنتهي صلاحية حسابك اليوم، %(expires_at)s."
msgstr[1] "تنتهي صلاحية حسابك خلال يوم واحد، في %(expires_at)s."
msgstr[2] "تنتهي صلاحية حسابك خلال يومين، في %(expires_at)s."
msgstr[3] "تنتهي صلاحية حسابك خلال %(days_left)s أيام، في %(expires_at)s."
msgstr[4] "تنتهي صلاحية حسابك خلال %(days_left)s يومًا، في %(expires_at)s."
msgstr[5] "تنتهي صلاحية حسابك خلال %(days_left)s يوم، في %(expires_at)s."

#, python-format
msgid "Commande %(reference)s de %(customer_name)s : %(total_amount)s MRU."
msgstr "الطلب %(reference)s من %(customer_name)s: %(total_amount)s أوقية."

#, python-format
msgid ""
"Produits créés en brouillon : %(success_count)s. Lignes en erreur : "
"%(error_count)s."
msgstr ""
"المنتجات المنشأة كمسودات: %(success_count)s. الأسطر التي بها أخطاء: "
"%(error_count)s."

#, python-format
msgid "L'import n'a pas pu être traité : %(failure_reason)s"
msgstr "تعذرت معالجة الاستيراد: %(failure_reason)s"

#, python-format
msgid ""
"Le produit %(product_name)s a été retiré par l'administrateur : %(reason)s"
msgstr "سحب المسؤول المنتج %(product_name)s: %(reason)s"

