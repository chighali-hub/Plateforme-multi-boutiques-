msgid "Opération impossible."
msgstr "لا يمكن إجراء هذه العملية."

msgid "Le code saisi est incorrect."
msgstr "الرمز المدخل غير صحيح."

msgid "Ce code a expiré ou n'est plus valable. Demandez un nouveau code."
msgstr "انتهت صلاحية هذا الرمز أو لم يعد صالحًا. اطلب رمزًا جديدًا."

msgid "Trop d'essais incorrects. Demandez un nouveau code."
msgstr "عدد كبير من المحاولات الخاطئة. اطلب رمزًا جديدًا."

msgid "Ce lien de réinitialisation est invalide ou a expiré."
msgstr "رابط إعادة التعيين غير صالح أو منتهي الصلاحية."

msgid "E-mail ou mot de passe incorrect."
msgstr "البريد الإلكتروني أو كلمة المرور غير صحيحة."

msgid "Votre adresse e-mail n'est pas encore vérifiée."
msgstr "لم يتم التحقق من بريدك الإلكتروني بعد."

msgid "Ce compte est bloqué. Contactez l'administrateur."
msgstr "هذا الحساب محظور. تواصل مع المسؤول."

msgid "Ce compte a expiré. Pour le recharger, contactez l'administrateur."
msgstr "انتهت صلاحية هذا الحساب. لتجديده، تواصل مع المسؤول."

msgid "Cette action n'est pas disponible dans l'état actuel de la boutique."
msgstr "هذا الإجراء غير متاح في الحالة الحالية للمتجر."

msgid "Cette adresse e-mail est déjà utilisée."
msgstr "هذا البريد الإلكتروني مستخدم بالفعل."

msgid "Cette adresse e-mail est déjà vérifiée."
msgstr "تم التحقق من هذا البريد الإلكتروني بالفعل."

msgid "Cette action n'est pas possible dans l'état actuel."
msgstr "هذا الإجراء غير ممكن في الحالة الحالية."

msgid "Cette étape de l'inscription n'est pas disponible maintenant."
msgstr "هذه المرحلة من التسجيل غير متاحة الآن."

msgid "La limite autorisée est atteinte."
msgstr "تم بلوغ الحد المسموح به."

msgid "Un import est déjà en cours."
msgstr "هناك عملية استيراد جارية بالفعل."

msgid "Certains produits du panier ne sont plus disponibles."
msgstr "بعض منتجات السلة لم تعد متوفرة."

msgid "Le fichier est trop volumineux."
msgstr "حجم الملف كبير جدًا."

msgid "Veuillez patienter avant de demander un nouveau code."
msgstr "يرجى الانتظار قبل طلب رمز جديد."

msgid "Les données envoyées sont invalides."
msgstr "البيانات المرسلة غير صالحة."

msgid "Authentification requise."
msgstr "تسجيل الدخول مطلوب."

msgid "Session invalide ou expirée."
msgstr "الجلسة غير صالحة أو منتهية."

msgid "Vous n'avez pas accès à cette ressource."
msgstr "ليس لديك صلاحية الوصول إلى هذا المورد."

msgid "Ressource introuvable."
msgstr "المورد غير موجود."

msgid "Méthode non autorisée."
msgstr "الطريقة غير مسموح بها."

msgid "Format de requête non pris en charge."
msgstr "صيغة الطلب غير مدعومة."

msgid "Format de réponse non disponible."
msgstr "صيغة الرد غير متاحة."

msgid "Trop de requêtes. Réessayez plus tard."
msgstr "طلبات كثيرة جدًا. أعد المحاولة لاحقًا."

msgid "Une erreur inattendue est survenue."
msgstr "حدث خطأ غير متوقع."

